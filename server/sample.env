REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m

### Oauth
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=

### EMAIL
EMAIL_API_KEY=
RESEND_FROM_EMAIL=email@your_domain.com
EMAIL_LOGO_URL=
