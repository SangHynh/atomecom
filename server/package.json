{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "node dist/server.js",
    "build": "tsc && npm run copy-templates",
    "copy-templates": "copyfiles -u 1 \"src/modules/emails/templates/*.hbs\" dist/",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:unit": "cross-env NODE_ENV=test jest --runInBand --testPathPattern=spec\\.ts$",
    "test:integration": "cross-env NODE_ENV=test jest --runInBand --testPathPattern=integration\\.spec\\.ts$",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "check": "tsc --noEmit",
    "genkey": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@atomecom/shared": "^1.0.0",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "caniuse-lite": "^1.0.30001770",
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.5.0",
    "handlebars": "^4.7.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.3",
    "morgan": "^1.10.1",
